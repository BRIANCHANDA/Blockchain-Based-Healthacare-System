try/
mobile/node_modules/
node_modules/
mobile/android/app/build/
mobile/android/.gradle/
backend/uploads/
fabric-network/fabric-samples/
mobile/.expo/

# Firebase client config — contains an API key scoped to the app package.
# Not strictly a secret (Google publishes it in every Android APK), but kept out
# of a public repo. Re-download from the Firebase console if you clone fresh:
# Project settings -> Your apps -> Android -> google-services.json
mobile/google-services.json

# Firebase service-account keys — REAL credentials (private key, can send push
# and sign as the service account). Never commit. Already uploaded to EAS;
# regenerate from the Firebase console if one is ever needed again.
mobile/*firebase-adminsdk*.json

# Hyperledger Fabric MSP material — certificates and PRIVATE KEYS.
#
# Regenerated by fabric-network/network/start-network.sh, which does
# `rm -rf organizations` then `cryptogen generate`, so nothing here is
# irreplaceable. It must not be in version control: the priv_sk files are
# signing keys for the orderer, every peer organisation and every admin
# identity, and anyone holding them can impersonate those identities.
fabric-network/network/organizations/

# Local mobile environment. EXPO_PUBLIC_* values are inlined into the bundle,
# so this holds no secrets — but it holds one developer's LAN address, which
# would break the app for everyone else. Template is mobile/.env.example.
mobile/.env
