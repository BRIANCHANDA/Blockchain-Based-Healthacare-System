# MedLink backend — environment template.
#
#   cp .env.example .env    then fill in the values below.
#
# Every variable the code reads is listed. Ones marked REQUIRED will stop the
# server starting in production if they are missing or weak.

# ── REQUIRED: secrets ────────────────────────────────────────────────────────
# Generate each one separately:  openssl rand -base64 48
#
# In production, src/lib/env.ts refuses to start if either is unset, shorter
# than 32 characters, or set to a known placeholder. In development a random
# per-process value is used instead, with a warning — so sessions do not
# survive a restart until you set these properly.

# Signs session tokens. Anyone who knows this can forge a login as any user.
JWT_SECRET=

# Encrypts personal and clinical fields at rest (AES-256-CBC).
# CHANGING THIS MAKES EXISTING DATA UNREADABLE — every encrypted column was
# written with the previous key. Treat it as permanent for a given database.
AES_SECRET_KEY=

# ── REQUIRED: database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_data

# Used only by `bun test`. Must be a SEPARATE database — the test suite inserts
# and deletes freely, and refuses to run against a name without "test" in it.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_test

# ── REQUIRED: Hyperledger Fabric ─────────────────────────────────────────────
# Absolute path to fabric-network/network/organizations
FABRIC_NETWORK_PATH=/absolute/path/to/fabric-network/network/organizations
FABRIC_CHANNEL=healthchannel
FABRIC_CHAINCODE=healthcare

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Public base URL, used to build absolute links to uploaded radiology images.
# Must be set in production or those links point at localhost.
BASE_URL=http://localhost:3000

# Set automatically by Render; leave blank elsewhere.
RENDER_EXTERNAL_URL=

# ── Email (one-time codes for staff sign-in) ─────────────────────────────────
# Without these, staff login cannot deliver its 2FA code.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.zm

# Development convenience: send every email to this address instead of the
# real recipient. Leave blank in production.
DEV_EMAIL_OVERRIDE=

# ── Push notifications (mobile) ──────────────────────────────────────────────
# Optional. Raises Expo's rate limits; delivery works without it.
# The FCM credentials themselves live in the EAS project, not here.
EXPO_ACCESS_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
# Salt for deriving blockchain addresses.
BLOCKCHAIN_SALT=

# Clinical-notes assistance. The feature degrades gracefully if unset.
GROQ_API_KEY=

# Set to "true" ONLY for load testing. Never in production — it disables the
# login throttle that limits brute-force attempts to 5 per 15 minutes.
DISABLE_RATE_LIMIT=

# Used by the verification scripts in src/scripts/.
API_URL=http://localhost:3000
REPORT_OUT_DIR=./reports

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API in production.
# Ignored in development, where any origin is accepted.
# The mobile app is unaffected: native requests send no Origin header.
CORS_ORIGINS=https://portal.yourdomain.zm
