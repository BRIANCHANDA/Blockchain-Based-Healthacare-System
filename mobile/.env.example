# MedLink mobile — environment template.
#
#   cp .env.example .env
#
# Expo inlines EXPO_PUBLIC_* variables at build time, so these end up in the
# shipped bundle. Never put a secret here.

# Backend the app talks to. On a physical device in development this must be
# the host machine's LAN IP — `localhost` on a phone means the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.0.126:3000
