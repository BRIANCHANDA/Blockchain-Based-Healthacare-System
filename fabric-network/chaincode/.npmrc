package-lock=false

# The Fabric peer builds node chaincode by running `npm install --omit=dev`
# inside a throwaway container whose link to the npm registry is slow and drops
# requests, producing `npm error code ETIMEDOUT` install failures. Retry, but
# don't back off so far that the build outlives the peer's install timeout
# (CORE_CHAINCODE_INSTALLTIMEOUT in network/docker-compose.yaml).
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000
registry=https://registry.npmjs.org/
audit=false
fund=false
